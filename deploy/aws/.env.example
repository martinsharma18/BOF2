# Copy to .env on the server and fill in. Never commit .env.

# The server's address. No domain? Use the static IP with dashes + .sslip.io, e.g. 13-232-10-5.sslip.io
DOMAIN=

# Same values you have in Render → bof2-api → Environment (copy them across).
ConnectionStrings__Default=
Jwt__Key=
Seed__AdminEmail=
Seed__AdminPassword=
Cloudinary__Url=
WebPush__PublicKey=
WebPush__PrivateKey=
WebPush__Subject=

# Forgot-password emails through Brevo: API key (xkeysib-...) + a sender address verified in Brevo.
Email__BrevoApiKey=
Email__FromEmail=
# Or Gmail SMTP instead: the Gmail address + its 16-letter App password.
Email__SmtpUser=
Email__SmtpPassword=
